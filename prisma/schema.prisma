generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  role          Role      @default(USER)
  orders        Order[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Product {
  id          String           @id @default(uuid())
  name        String           // Ej. "Café Serranía del Perijá"
  slug        String           @unique
  description String           @db.Text
  images      String[]         // URLs de imágenes
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  isFeatured  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductVariant {
  id          String      @id @default(uuid())
  productId   String
  name        String      // Ej. "250g", "1kg", "Molido"
  price       Int         // Precio en centavos para precisión
  inventory   Int         @default(0)
  product     Product     @relation(fields: [productId], references: [id])
  orderItems  OrderItem[]
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  products    Product[]
}

model Order {
  id            String      @id @default(uuid())
  userId        String?     // Opcional para soportar "Guest Checkout"
  customerEmail String      // Siempre requerido para seguimiento
  user          User?       @relation(fields: [userId], references: [id])
  status        OrderStatus @default(PENDING)
  totalAmount   Int         // Total en centavos
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id               String         @id @default(uuid())
  orderId          String
  productVariantId String
  quantity         Int
  price            Int            // Precio unitario en centavos (congelado)
  order            Order          @relation(fields: [orderId], references: [id])
  variant          ProductVariant @relation(fields: [productVariantId], references: [id])
}

// Sporbarhet (/sporbarhet) — kafferegistrene som før lå i Supabase Postgres.
// Feltnavn matcher tabellene som opprettes av gcp/sql/001_init_coffee_lots_and_waitlist.sql
// slik at en pg_dump/pg_restore fra Supabase til Cloud SQL lander uten transformasjon.
model CoffeeLot {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotNumber String   @unique @map("lot_number")
  active    Boolean  @default(true)

  // Produkt
  productName String?   @map("product_name")
  grind       String? // "Hele bønner" | "Malt"
  netWeight   String?   @map("net_weight")
  roastDegree String?   @map("roast_degree")
  roastDate   DateTime? @map("roast_date") @db.Date
  bestBefore  DateTime? @map("best_before") @db.Date

  // Opprinnelse
  country       String? @default("Colombia")
  region        String?
  municipality  String?
  farm          String?
  producer      String?
  altitude      String?
  harvestPeriod String? @map("harvest_period")

  // Kaffen
  species    String? @default("100 % Arabica")
  variety    String?
  grade      String? // "Excelso" | "Especial"
  process    String?
  screenSize String? @map("screen_size")

  // Kvalitetskontroll
  moisture       String?
  waterActivity  String? @map("water_activity")
  defects        String?
  labNotes       String? @map("lab_notes")
  cuppingScore   String? @map("cupping_score")
  flavourProfile String? @map("flavour_profile")

  // Fra Colombia til Norge
  exporter           String?   @default("CACE L&G S.A.S.")
  exportDate         DateTime? @map("export_date") @db.Date
  importer           String?   @default("GUATILLA AS")
  receivedDateNorway DateTime? @map("received_date_norway") @db.Date

  // Brenning og pakking
  roastedBy       String?   @default("GUATILLA AS") @map("roasted_by")
  packingDate     DateTime? @map("packing_date") @db.Date
  productionNotes String?   @map("production_notes")

  // Historien bak kaffen
  storyText     String? @map("story_text")
  storyVideoUrl String? @map("story_video_url")
  images        Json    @default("[]") // [{ id, url, caption }]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("coffee_lots")
}

model Waitlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  source    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("waitlist")
}
