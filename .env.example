# Server-only order notifications. Never expose these values through NEXT_PUBLIC_*.
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
# The domain must be verified in Resend before production sending.
ORDER_NOTIFICATION_FROM=Kaffe Guatilla <pedidos@guatilla.no>

# Optional PostgreSQL pool limit. Keep this low for local Cloud SQL access.
DATABASE_POOL_MAX=5
